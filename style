/* =========================================================
JEEVANROUTE
Emergency Response System
========================================================= */

/* ================= RESET ================= */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  --primary: #2563eb;
  --primary-dark: #1d4ed8;

  --danger: #dc2626;
  --danger-dark: #b91c1c;

  --success: #16a34a;

  --warning: #f59e0b;

  --purple: #7c3aed;

  --dark: #0f172a;
  --dark-2: #1e293b;

  --text: #1e293b;
  --text-light: #64748b;

  --background: #f8fafc;

  --white: #ffffff;

  --border: #e2e8f0;

  --sidebar-width: 250px;

  --shadow: 0 4px 15px rgba(15, 23, 42, 0.06);

  --radius: 14px;
}

body {
  font-family:
    Inter,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  background: var(--background);

  color: var(--text);

  min-height: 100vh;
}

/* ================= SIDEBAR ================= */

.sidebar {
  position: fixed;

  left: 0;
  top: 0;

  width: var(--sidebar-width);
  height: 100vh;

  background:
    linear-gradient(
      180deg,
      #0f172a 0%,
      #111827 100%
    );

  color: white;

  display: flex;
  flex-direction: column;

  z-index: 100;

  padding: 24px 16px;
}

/* LOGO */

.logo {
  display: flex;

  align-items: center;

  gap: 12px;

  padding: 0 8px 28px;

  border-bottom:
    1px solid rgba(255,255,255,0.08);
}

.logo-icon {
  width: 44px;
  height: 44px;

  border-radius: 12px;

  display: flex;

  align-items: center;
  justify-content: center;

  background:
    linear-gradient(
      135deg,
      #ef4444,
      #dc2626
    );

  box-shadow:
    0 8px 20px rgba(220,38,38,0.25);

  font-size: 20px;
}

.logo h2 {
  font-size: 18px;

  font-weight: 700;

  letter-spacing: -0.4px;
}

.logo span {
  display: block;

  font-size: 10px;

  color: #94a3b8;

  margin-top: 3px;
}

/* NAVIGATION */

.navigation {
  display: flex;

  flex-direction: column;

  gap: 6px;

  margin-top: 25px;
}

.nav-item {
  border: none;

  background: transparent;

  color: #94a3b8;

  width: 100%;

  padding: 12px 14px;

  border-radius: 10px;

  display: flex;

  align-items: center;

  gap: 13px;

  font-size: 14px;

  cursor: pointer;

  transition:
    0.2s ease;

  text-align: left;
}

.nav-item i {
  width: 20px;

  text-align: center;

  font-size: 15px;
}

.nav-item:hover {
  background:
    rgba(255,255,255,0.06);

  color: white;
}

.nav-item.active {
  background:
    linear-gradient(
      90deg,
      rgba(37,99,235,0.9),
      rgba(37,99,235,0.65)
    );

  color: white;

  box-shadow:
    0 6px 15px rgba(37,99,235,0.18);
}

/* SIDEBAR BOTTOM */

.sidebar-bottom {
  margin-top: auto;
}

.system-status {
  display: flex;

  align-items: center;

  gap: 10px;

  padding: 13px;

  background:
    rgba(255,255,255,0.05);

  border-radius: 10px;

  margin-bottom: 18px;
}

.status-dot {
  width: 9px;
  height: 9px;

  background: #22c55e;

  border-radius: 50%;

  box-shadow:
    0 0 0 4px rgba(34,197,94,0.12);
}

.system-status strong {
  display: block;

  font-size: 12px;
}

.system-status small {
  display: block;

  color: #64748b;

  font-size: 10px;

  margin-top: 2px;
}

.sidebar-footer {
  display: flex;

  justify-content: space-between;

  color: #64748b;

  font-size: 9px;

  padding: 0 5px;
}

/* ================= MAIN ================= */

.main-content {
  margin-left: var(--sidebar-width);

  min-height: 100vh;

  padding: 0 32px 40px;
}

/* ================= TOPBAR ================= */

.topbar {
  min-height: 92px;

  display: flex;

  align-items: center;

  justify-content: space-between;

  border-bottom:
    1px solid var(--border);

  margin-bottom: 30px;
}

.topbar h1 {
  font-size: 24px;

  letter-spacing: -0.6px;
}

.topbar p {
  color: var(--text-light);

  font-size: 13px;

  margin-top: 4px;
}

.topbar-right {
  display: flex;

  align-items: center;

  gap: 20px;
}

.live-indicator {
  display: flex;

  align-items: center;

  gap: 7px;

  font-size: 11px;

  font-weight: 700;

  color: var(--success);

  background:
    #f0fdf4;

  padding: 7px 10px;

  border-radius: 20px;
}

.live-indicator span {
  width: 7px;
  height: 7px;

  border-radius: 50%;

  background: var(--success);

  animation: blink 1.5s infinite;
}

@keyframes blink {
  0%, 100% {
    opacity: 1;
  }

  50% {
    opacity: 0.35;
  }
}

.date-display {
  color: var(--text-light);

  font-size: 12px;

  display: flex;

  gap: 7px;

  align-items: center;
}

/* ================= SECTIONS ================= */

.page-section {
  display: none;

  animation:
    fadeIn 0.25s ease;
}

.page-section.active-section {
  display: block;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(5px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ================= WELCOME ================= */

.welcome-card {
  position: relative;

  overflow: hidden;

  min-height: 220px;

  border-radius: 20px;

  padding: 32px 38px;

  background:
    linear-gradient(
      120deg,
      #172554,
      #1d4ed8
    );

  color: white;

  display: flex;

  justify-content: space-between;

  align-items: center;

  box-shadow:
    0 15px 30px rgba(37,99,235,0.15);
}

.welcome-tag {
  display: inline-flex;

  align-items: center;

  gap: 7px;

  font-size: 10px;

  text-transform: uppercase;

  letter-spacing: 1px;

  color: #bfdbfe;

  background:
    rgba(255,255,255,0.08);

  padding: 7px 10px;

  border-radius: 20px;

  margin-bottom: 15px;
}

.welcome-card h2 {
  font-size: 29px;

  letter-spacing: -1px;

  margin-bottom: 8px;
}

.welcome-card h2 span {
  color: #93c5fd;
}

.welcome-card p {
  color: #bfdbfe;

  font-size: 13px;

  max-width: 530px;

  line-height: 1.7;

  margin-bottom: 22px;
}

.welcome-illustration {
  position: relative;

  width: 180px;
  height: 180px;

  display: flex;

  align-items: center;
  justify-content: center;

  margin-right: 50px;
}

.welcome-illustration > i {
  font-size: 90px;

  position: relative;

  z-index: 2;

  opacity: 0.95;
}

.pulse-ring {
  position: absolute;

  width: 160px;
  height: 160px;

  border-radius: 50%;

  border:
    1px solid rgba(255,255,255,0.18);

  animation:
    pulse 2.5s infinite;
}

@keyframes pulse {
  0% {
    transform: scale(0.8);
    opacity: 0.8;
  }

  100% {
    transform: scale(1.25);
    opacity: 0;
  }
}

/* ================= BUTTONS ================= */

.primary-btn,
.danger-btn,
.secondary-btn {
  border: none;

  border-radius: 9px;

  padding: 11px 17px;

  font-size: 12px;

  font-weight: 600;

  cursor: pointer;

  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 8px;

  transition:
    0.2s ease;
}

.primary-btn {
  color: white;

  background:
    var(--primary);

  box-shadow:
    0 5px 12px rgba(37,99,235,0.18);
}

.primary-btn:hover {
  background:
    var(--primary-dark);

  transform:
    translateY(-1px);
}

.welcome-card .primary-btn {
  background: white;

  color: #1d4ed8;
}

.welcome-card .primary-btn:hover {
  background: #eff6ff;
}

.danger-btn {
  color: white;

  background: var(--danger);
}

.danger-btn:hover {
  background: var(--danger-dark);

  transform:
    translateY(-1px);
}

.secondary-btn {
  background: #f1f5f9;

  color: var(--text);
}

.secondary-btn:hover {
  background: #e2e8f0;
}

/* ================= STATS ================= */

.stats-grid {
  display: grid;

  grid-template-columns:
    repeat(4, 1fr);

  gap: 15px;

  margin-top: 20px;
}

.stat-card {
  background: white;

  border:
    1px solid var(--border);

  border-radius: var(--radius);

  padding: 18px;

  display: flex;

  align-items: center;

  gap: 14px;

  box-shadow: var(--shadow);
}

.stat-icon {
  width: 45px;
  height: 45px;

  border-radius: 11px;

  display: flex;

  align-items: center;
  justify-content: center;

  font-size: 17px;
}

.stat-icon.blue {
  background: #eff6ff;

  color: #2563eb;
}

.stat-icon.red {
  background: #fef2f2;

  color: #dc2626;
}

.stat-icon.green {
  background: #f0fdf4;

  color: #16a34a;
}

.stat-icon.purple {
  background: #f5f3ff;

  color: #7c3aed;
}

.stat-card span {
  display: block;

  font-size: 11px;

  color: var(--text-light);

  margin-bottom: 3px;
}

.stat-card strong {
  font-size: 22px;

  letter-spacing: -0.5px;
}

/* ================= DASHBOARD GRID ================= */

.dashboard-grid {
  display: grid;

  grid-template-columns:
    1.5fr 1fr;

  gap: 20px;

  margin-top: 20px;
}

/* ================= PANEL ================= */

.panel {
  background: white;

  border:
    1px solid var(--border);

  border-radius: var(--radius);

  box-shadow: var(--shadow);

  overflow: hidden;
}

.panel-header {
  display: flex;

  justify-content: space-between;

  align-items: center;

  padding: 20px 22px;

  border-bottom:
    1px solid #f1f5f9;
}

.panel-header h3 {
  font-size: 14px;
}

.panel-header p {
  font-size: 11px;

  color: var(--text-light);

  margin-top: 4px;
}

.view-btn {
  border: none;

  background: #eff6ff;

  color: var(--primary);

  font-size: 11px;

  font-weight: 600;

  padding: 7px 10px;

  border-radius: 7px;

  cursor: pointer;
}

/* ================= EMPTY STATE ================= */

.empty-state {
  padding: 42px 20px;

  text-align: center;

  color: var(--text-light);
}

.empty-state i {
  color: var(--success);

  font-size: 27px;

  margin-bottom: 10px;
}

.empty-state p {
  font-size: 13px;

  font-weight: 600;

  color: var(--text);
}

.empty-state small {
  font-size: 10px;

  display: block;

  margin-top: 4px;
}

/* ================= QUICK ACTIONS ================= */

.quick-actions {
  padding: 15px;

  display: grid;

  grid-template-columns:
    1fr 1fr;

  gap: 10px;
}

.quick-actions button {
  border:
    1px solid var(--border);

  background: #fafafa;

  padding: 18px 10px;

  border-radius: 10px;

  cursor: pointer;

  display: flex;

  flex-direction: column;

  align-items: center;

  gap: 8px;

  color: var(--text);

  font-size: 10px;

  transition: 0.2s;
}

.quick-actions button i {
  font-size: 18px;

  color: var(--primary);
}

.quick-actions button:hover {
  border-color: #bfdbfe;

  background: #eff6ff;

  transform:
    translateY(-2px);
}

/* ================= SECTION HEADER ================= */

.section-header {
  display: flex;

  justify-content: space-between;

  align-items: center;

  margin-bottom: 20px;
}

.section-header h2 {
  font-size: 20px;

  letter-spacing: -0.4px;
}

.section-header p {
  color: var(--text-light);

  font-size: 12px;

  margin-top: 4px;
}

/* ================= TABLE ================= */

.table-container {
  overflow-x: auto;
}

table {
  width: 100%;

  border-collapse: collapse;
}

thead {
  background: #f8fafc;
}

th {
  text-align: left;

  padding: 13px 20px;

  font-size: 10px;

  color: #64748b;

  text-transform: uppercase;

  letter-spacing: 0.5px;
}

td {
  padding: 15px 20px;

  font-size: 12px;

  border-top:
    1px solid #f1f5f9;
}

tbody tr:hover {
  background: #fafcff;
}

/* ================= STATUS ================= */

.status-badge {
  display: inline-flex;

  align-items: center;

  gap: 5px;

  padding: 5px 8px;

  border-radius: 20px;

  font-size: 9px;

  font-weight: 700;
}

.status-badge.available {
  color: #15803d;

  background: #f0fdf4;
}

.status-badge.busy {
  color: #b91c1c;

  background: #fef2f2;
}

.status-badge.waiting {
  color: #b45309;

  background: #fffbeb;
}

.status-badge.dispatched {
  color: #1d4ed8;

  background: #eff6ff;
}

/* ================= EMPTY TABLE ================= */

.empty-table {
  text-align: center;

  padding: 60px 20px;

  color: var(--text-light);
}

.empty-table i {
  font-size: 35px;

  color: #cbd5e1;

  margin-bottom: 12px;
}

.empty-table h3 {
  font-size: 14px;

  color: var(--text);

  margin-bottom: 5px;
}

.empty-table p {
  font-size: 11px;
}

/* ================= FORMS ================= */

.form-group {
  margin-bottom: 18px;
}

.form-group label {
  display: block;

  font-size: 11px;

  font-weight: 600;

  color: #475569;

  margin-bottom: 7px;
}

input,
select {
  width: 100%;

  border:
    1px solid var(--border);

  border-radius: 8px;

  padding: 11px 12px;

  font-size: 12px;

  outline: none;

  background: white;

  color: var(--text);

  transition: 0.2s;
}

input:focus,
select:focus {
  border-color: #93c5fd;

  box-shadow:
    0 0 0 3px rgba(37,99,235,0.08);
}

input::placeholder {
  color: #94a3b8;
}

/* ================= MODAL ================= */

.modal-overlay {
  position: fixed;

  inset: 0;

  background:
    rgba(15,23,42,0.55);

  backdrop-filter:
    blur(4px);

  display: none;

  align-items: center;
  justify-content: center;

  z-index: 500;

  padding: 20px;
}

.modal-overlay.show {
  display: flex;

  animation:
    fadeIn 0.2s ease;
}

.modal {
  background: white;

  width: 100%;

  max-width: 500px;

  border-radius: 17px;

  box-shadow:
    0 25px 60px rgba(15,23,42,0.25);

  overflow: hidden;
}

.modal-header {
  display: flex;

  justify-content: space-between;

  align-items: flex-start;

  padding: 22px;

  border-bottom:
    1px solid var(--border);
}

.modal-header h2 {
  font-size: 18px;
}

.modal-header p {
  font-size: 11px;

  color: var(--text-light);

  margin-top: 4px;
}

.close-btn {
  border: none;

  background: #f1f5f9;

  color: #64748b;

  width: 30px;
  height: 30px;

  border-radius: 7px;

  cursor: pointer;
}

.close-btn:hover {
  background: #fee2e2;

  color: var(--danger);
}

.modal form {
  padding: 22px;
}

.form-grid {
  display: grid;

  grid-template-columns:
    1fr 1fr;

  gap: 15px;
}

.modal-actions {
  display: flex;

  justify-content: flex-end;

  gap: 10px;

  margin-top: 24px;
}

/* ================= EMERGENCY ================= */

.emergency-layout {
  display: grid;

  grid-template-columns:
    1fr 1fr;

  gap: 20px;
}

.emergency-layout .panel {
  padding-bottom: 20px;
}

.emergency-layout form {
  padding: 20px;
}

.process-info {
  text-align: center;

  padding: 25px;
}

.process-icon {
  width: 65px;
  height: 65px;

  margin: 0 auto 15px;

  border-radius: 50%;

  display: flex;

  align-items: center;
  justify-content: center;

  background: #eff6ff;

  color: var(--primary);

  font-size: 25px;
}

.process-info h3 {
  font-size: 15px;

  margin-bottom: 6px;
}

.process-info p {
  font-size: 11px;

  color: var(--text-light);

  max-width: 270px;

  margin: 0 auto 18px;

  line-height: 1.6;
}

.red-text {
  color: var(--danger);
}

.margin-top {
  margin-top: 20px;
}

.queue-badge {
  background: #fff7ed;

  color: #c2410c;

  padding: 6px 10px;

  border-radius: 20px;

  font-size: 10px;

  font-weight: 700;
}

.emergency-list {
  padding: 10px 20px 20px;
}

.emergency-item {
  display: flex;

  align-items: center;

  justify-content: space-between;

  padding: 14px;

  border:
    1px solid var(--border);

  border-radius: 10px;

  margin-top: 10px;

  background: #fff;
}

.emergency-patient {
  display: flex;

  align-items: center;

  gap: 12px;
}

.patient-avatar {
  width: 38px;
  height: 38px;

  border-radius: 10px;

  background: #eff6ff;

  color: var(--primary);

  display: flex;

  align-items: center;
  justify-content: center;

  font-size: 14px;
}

.emergency-patient strong {
  display: block;

  font-size: 12px;
}

.emergency-patient small {
  display: block;

  color: var(--text-light);

  font-size: 10px;

  margin-top: 2px;
}

/* ================= AMBULANCES ================= */

.ambulance-grid {
  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 18px;
}

.ambulance-card {
  background: white;

  border:
    1px solid var(--border);

  border-radius: 14px;

  padding: 20px;

  box-shadow: var(--shadow);

  transition: 0.2s;
}

.ambulance-card:hover {
  transform:
    translateY(-3px);

  box-shadow:
    0 10px 25px rgba(15,23,42,0.09);
}

.ambulance-top {
  display: flex;

  justify-content: space-between;

  align-items: center;

  margin-bottom: 18px;
}

.ambulance-icon {
  width: 48px;
  height: 48px;

  border-radius: 11px;

  background: #eff6ff;

  color: var(--primary);

  display: flex;

  align-items: center;
  justify-content: center;

  font-size: 20px;
}

.ambulance-card h3 {
  font-size: 15px;

  margin-bottom: 3px;
}

.ambulance-card p {
  color: var(--text-light);

  font-size: 10px;
}

.ambulance-location {
  border-top:
    1px solid #f1f5f9;

  padding-top: 14px;

  margin-top: 14px;

  display: flex;

  gap: 8px;

  color: var(--text-light);

  font-size: 10px;
}

/* ================= HOSPITALS ================= */

.hospital-grid {
  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 18px;
}

.hospital-card {
  background: white;

  border:
    1px solid var(--border);

  border-radius: 14px;

  padding: 20px;

  box-shadow: var(--shadow);

  transition: 0.2s;
}

.hospital-card:hover {
  transform:
    translateY(-3px);

  box-shadow:
    0 10px 25px rgba(15,23,42,0.09);
}

.hospital-header {
  display: flex;

  gap: 12px;

  align-items: center;

  margin-bottom: 18px;
}

.hospital-icon {
  width: 45px;
  height: 45px;

  border-radius: 10px;

  background: #fef2f2;

  color: var(--danger);

  display: flex;

  align-items: center;
  justify-content: center;

  font-size: 18px;
}

.hospital-card h3 {
  font-size: 13px;
}

.hospital-card p {
  color: var(--text-light);

  font-size: 10px;

  margin-top: 3px;
}

.facilities {
  display: flex;

  gap: 7px;

  flex-wrap: wrap;
}

.facility {
  padding: 6px 8px;

  border-radius: 6px;

  font-size: 9px;

  font-weight: 600;
}

.facility.available {
  color: #15803d;

  background: #f0fdf4;
}

.facility.unavailable {
  color: #64748b;

  background: #f1f5f9;
}

/* ================= TOAST ================= */

.toast {
  position: fixed;

  right: 25px;

  bottom: 25px;

  width: 320px;

  background: white;

  border:
    1px solid var(--border);

  border-radius: 12px;

  padding: 14px 15px;

  box-shadow:
    0 15px 40px rgba(15,23,42,0.15);

  display: flex;

  align-items: center;

  gap: 11px;

  z-index: 1000;

  transform:
    translateX(400px);

  opacity: 0;

  transition:
    0.3s ease;
}

.toast.show {
  transform:
    translateX(0);

  opacity: 1;
}

.toast > i {
  font-size: 19px;

  color: var(--success);
}

.toast strong {
  font-size: 12px;

  display: block;
}

.toast p {
  font-size: 10px;

  color: var(--text-light);

  margin-top: 2px;
}

.toast button {
  margin-left: auto;

  border: none;

  background: transparent;

  color: #94a3b8;

  cursor: pointer;
}

/* ================= RESPONSIVE ================= */

@media (max-width: 1100px) {
  .stats-grid {
    grid-template-columns:
      repeat(2, 1fr);
  }

  .dashboard-grid {
    grid-template-columns: 1fr;
  }

  .ambulance-grid,
  .hospital-grid {
    grid-template-columns:
      repeat(2, 1fr);
  }
}

@media (max-width: 800px) {
  :root {
    --sidebar-width: 70px;
  }

  .sidebar {
    padding: 18px 10px;
  }

  .logo {
    justify-content: center;

    padding: 0 0 20px;
  }

  .logo > div:last-child,
  .nav-item span,
  .system-status div,
  .sidebar-footer {
    display: none;
  }

  .logo-icon {
    width: 42px;
    height: 42px;
  }

  .nav-item {
    justify-content: center;

    padding: 13px 5px;
  }

  .main-content {
    padding: 0 18px 30px;
  }

  .welcome-card {
    padding: 25px;
  }

  .welcome-illustration {
    display: none;
  }

  .emergency-layout {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 600px) {
  .stats-grid {
    grid-template-columns: 1fr;
  }

  .ambulance-grid,
  .hospital-grid {
    grid-template-columns: 1fr;
  }

  .form-grid {
    grid-template-columns: 1fr;
  }

  .topbar-right {
    display: none;
  }

  .welcome-card h2 {
    font-size: 23px;
  }
}